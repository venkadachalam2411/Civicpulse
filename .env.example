# Backend Configuration
PORT=5000
MONGO_URI=mongodb+srv://civicpulse:<PASSWORD>@<ATLAS_CLUSTER_URL>/civicpulse
JWT_SECRET=civicpulse_secret_jwt_key_2026_super_secure

# AWS S3 Configuration (Optional - falls back to static uploads folder)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=civicpulse-issue-images

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_MAP_API_KEY=optional_tile_server_key
